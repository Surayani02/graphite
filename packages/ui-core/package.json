{
  "name": "@graphite/ui-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Graphite standalone design system: tokens + accessible React primitives.",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "clean": "rimraf dist",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@graphite/protocol": "workspace:*",
    "lucide-react": "^1.45.0",
    "react-aria-components": "1.21.1"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "vitest": "^4.1.10"
  }
}
